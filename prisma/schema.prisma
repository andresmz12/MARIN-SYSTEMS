generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  name             String
  calendarToken    String?             @unique
  createdAt        DateTime            @default(now())
  trades           Trade[]
  habits           Habit[]
  habitCompletions HabitCompletion[]
  events           Event[]
  journalEntries   JournalEntry[]
  dailyStates      DailyState[]
  checklists       PreTradeChecklist[]
  goals            Goal[]
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  pair         String
  result       String
  pips         Float?
  setup        String?
  emotion      String?
  followedPlan Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Habit {
  id          String            @id @default(cuid())
  userId      String
  name        String
  emoji       String
  category    String
  frequency   String
  isPreMarket Boolean           @default(false)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])
  completions HabitCompletion[]
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([habitId, date])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  date        DateTime
  time        String?
  type        String
  notes       String?
  isForexNews Boolean  @default(false)
  forexPair   String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mood      Int
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyState {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  mentalState     Int      @default(3)
  rutinaCompleted Boolean  @default(false)
  hasNews         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model PreTradeChecklist {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  deadline    DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  subGoals    SubGoal[]
}

model SubGoal {
  id          String            @id @default(cuid())
  goalId      String
  title       String
  completed   Boolean           @default(false)
  daily       Boolean           @default(false)
  createdAt   DateTime          @default(now())
  goal        Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completions GoalCompletion[]
}

model GoalCompletion {
  id        String   @id @default(cuid())
  subGoalId String
  date      String
  createdAt DateTime @default(now())
  subGoal   SubGoal  @relation(fields: [subGoalId], references: [id], onDelete: Cascade)

  @@unique([subGoalId, date])
}
