generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String
  name             String
  createdAt        DateTime            @default(now())
  trades           Trade[]
  habits           Habit[]
  habitCompletions HabitCompletion[]
  events           Event[]
  journalEntries   JournalEntry[]
  dailyStates      DailyState[]
  checklists       PreTradeChecklist[]
  companies        Company[]
}

model Trade {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  pair         String
  result       String
  pips         Float?
  setup        String?
  emotion      String?
  followedPlan Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Habit {
  id          String            @id @default(cuid())
  userId      String
  name        String
  emoji       String
  category    String
  frequency   String
  isPreMarket Boolean           @default(false)
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id])
  completions HabitCompletion[]
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      DateTime
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([habitId, date])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  date        DateTime
  time        String?
  type        String
  notes       String?
  isForexNews Boolean  @default(false)
  forexPair   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mood      Int
  content   String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DailyState {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  mentalState     Int      @default(3)
  rutinaCompleted Boolean  @default(false)
  hasNews         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model PreTradeChecklist {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model Company {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id])
  name         String
  description  String?
  emoji        String              @default("🏢")
  color        String              @default("#2563eb")
  status       String              @default("activa")
  industry     String?
  website      String?
  longDesc     String?
  foundedAt    DateTime?
  tools        String[]
  privateNotes String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tasks        CompanyTask[]
  notes        CompanyNote[]
  teamMembers  CompanyTeamMember[]
  links        CompanyLink[]
}

model CompanyTask {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  priority    String    @default("media")
  status      String    @default("pendiente")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CompanyNote {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyTeamMember {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  role      String
}

model CompanyLink {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  url         String
  type        String  @default("Web")
  description String?
}
