# Database - PostgreSQL connection string from Railway
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# NextAuth URL - your Railway app URL
NEXTAUTH_URL="https://your-app.railway.app"

# Anthropic API key - optional. Enables AI-generated work-block titles/steps in
# the CEO Command Center. If unset, the planner falls back to deterministic content.
ANTHROPIC_API_KEY=""
