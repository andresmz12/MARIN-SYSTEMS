# Database - PostgreSQL connection string from Railway
DATABASE_URL="postgresql://user:password@host:port/database"

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# NextAuth URL - your Railway app URL (e.g. https://marin-systems-production.up.railway.app)
NEXTAUTH_URL="https://your-app.railway.app"

# Public app URL — must match NEXTAUTH_URL exactly; used to build studio links
NEXT_PUBLIC_APP_URL="https://your-app.railway.app"

# Anthropic API key
ANTHROPIC_API_KEY=""

# ElevenLabs API key — used server-side for audio generation (Angie voice)
ELEVENLABS_API_KEY=""

# SendGrid — correos transaccionales y alertas de monitoreo
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@marinsystems.com"  # sender verificado en SendGrid
ALERT_EMAIL_TO="tu@email.com"                   # quién recibe alertas de agentes down/degraded
